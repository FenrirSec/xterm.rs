export PS1="\[\033[38;32m\]\u@\h\[\033[01;34m\] \w\[\033[01;33m\]\[\033[01;34m\] $\[\033[00m\] "


if [[ -z "${INITIALIZED}" ]];then
    export INITIALIZED=1
    # Creating temporary homedir
    HOMEDIR=$(echo $RANDOM | sha1sum | cut -c 1-6)
    mkdir $HOME/$HOMEDIR
    cd $HOME/$HOMEDIR
    export HOME=$HOME/$HOMEDIR
    clear
fi
